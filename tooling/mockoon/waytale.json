  "routes": [
    {
      "uuid": "94316c37-c647-45c8-be3d-18144125957e",
      "type": "http",
      "documentation": "Supabase Auth — pedir o código por email (signInWithOtp). Cenários pelo email: scenarios.json › auth.email.",
      "method": "post",
      "endpoint": "auth/v1/otp",
      "responses": [
        {
          "uuid": "6c4db5a5-5543-4813-a43f-f314d7e4e6ff",
          "label": "rate limited",
          "statusCode": 429,
          "body": "{ \"code\": \"over_email_send_rate_limit\", \"message\": \"email rate limit exceeded\" }",
          "headers": [
            {
              "key": "x-supabase-api-version",
              "value": "2024-01-01"
            }
          ],
          "rules": [
            {
              "target": "body",
              "modifier": "email",
              "value": "rate-limited@waytale.test",
              "invert": false,
              "operator": "equals"
            }
          ],
          "rulesOperator": "OR",
          "default": false
        },
        {
          "uuid": "3ba32b8e-3c50-4b4b-9428-b041735ce9c1",
          "label": "sender refuses the address",
          "statusCode": 400,
          "body": "{ \"code\": \"email_address_not_authorized\", \"message\": \"Email address not authorized\" }",
          "headers": [
            {
              "key": "x-supabase-api-version",
              "value": "2024-01-01"
            }
          ],
          "rules": [
            {
              "target": "body",
              "modifier": "email",
              "value": "not-authorized@waytale.test",
              "invert": false,
              "operator": "equals"
            }
          ],
          "rulesOperator": "OR",
          "default": false
        },
        {
          "uuid": "ba2d81e9-33d3-4a41-9059-18ac80269dcc",
          "label": "server error",
          "statusCode": 503,
          "body": "{ \"code\": \"unexpected_failure\", \"message\": \"Service unavailable\" }",
          "headers": [
            {
              "key": "x-supabase-api-version",
              "value": "2024-01-01"
            }
          ],
          "rules": [
            {
              "target": "body",
              "modifier": "email",
              "value": "server-error@waytale.test",
              "invert": false,
              "operator": "equals"
            }
          ],
          "rulesOperator": "OR",
          "default": false
        },
        {
          "uuid": "f6fd6882-a210-4f79-9b90-4a50a81236c3",
          "label": "code sent",
          "statusCode": 200,
          "body": "{}",
          "default": true
        }
      ]
    },
    {
      "uuid": "78ba2003-2b3e-4579-926d-50c57c4cea0e",
      "type": "http",
      "documentation": "Supabase Auth — verificar o código (verifyOtp). Qualquer código abre sessão para o email, exceto scenarios.json › auth.code.expired.",
      "method": "post",
      "endpoint": "auth/v1/verify",
      "responses": [
        {
          "uuid": "83bc9304-ad3f-4e97-875e-a91111fecb44",
          "label": "expired or wrong code",
          "statusCode": 403,
          "body": "{ \"code\": \"otp_expired\", \"message\": \"Token has expired or is invalid\" }",
          "headers": [
            {
              "key": "x-supabase-api-version",
              "value": "2024-01-01"
            }
          ],
          "rules": [
            {
              "target": "body",
              "modifier": "token",
              "value": "000000",
              "invert": false,
              "operator": "equals"
            }
          ],
          "rulesOperator": "OR",
          "default": false
        },
        {
          "uuid": "f969db6a-c34f-45b3-ad7e-63043985e470",
          "label": "session",
          "statusCode": 200,
          "bodyType": "FILE",
          "filePath": "./data/auth/session.json",
          "default": true
        }
      ]
    },
