{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ta-na-mao.local/schemas/skill-eval.schema.json",
  "title": "Tá na Mão agent skill evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skill", "rubric", "minimum_score", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "rubric": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$" },
    "minimum_score": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "expect", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "prompt": { "type": "string", "minLength": 20 },
          "expect": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 5 }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
