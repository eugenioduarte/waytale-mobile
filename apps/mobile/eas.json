{
  "cli": {
    "version": "24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.19.0",
      "pnpm": "10.15.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.19.0",
      "pnpm": "10.15.0",
      "env": {
        "EXPO_PUBLIC_BACKEND_DISABLED": "true",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "internal",
      "environment": "production",
      "node": "24.19.0",
      "pnpm": "10.15.0",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_STORYBOOK_ENABLED": "false", "EXPO_PUBLIC_BACKEND_DISABLED": "false" },
      "android": { "buildType": "apk" }
    }
  }
}
