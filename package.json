{
  "name": "waytale",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "mockoon": "pnpm --filter @waytale/mockoon-config start",
    "run:android": "pnpm --filter mobile android",
    "run:ios": "pnpm --filter mobile ios",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/mobile/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter mobile exec eslint --fix"
    ],
    "packages/ui/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter @waytale/ui exec eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
